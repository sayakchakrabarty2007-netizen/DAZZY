<?xml version="1.0" ?>
<robot name="Mini_Dog_URDF" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- ================================================================== -->
<!-- Gazebo Harmonic (Gz Sim 8) Configuration                           -->
<!-- Mini Robot Dog - DAZZY                                             -->
<!--                                                                    -->
<!-- Physics: DART engine for accurate closed-loop 4-bar linkage        -->
<!-- Servos: PTK-7465 (0.5394 N·m stall, 13.96 rad/s no-load)         -->
<!-- Battery: Tattu 300mAh 7.6V 75C 2S1P LiHV                         -->
<!-- IMU: MPU6050-style with realistic Gaussian noise                   -->
<!-- PBR: Physically Based Rendering materials                          -->
<!--                                                                    -->
<!-- MATERIAL FRICTION MODEL:                                           -->
<!--   All parts 3D printed on Anycubic Kobra S1                       -->
<!--   Infill pattern: GYROID for all parts                             -->
<!--   Floor: Medium smooth ceramic/vitrified tile (Indian lab floor)   -->
<!--                                                                    -->
<!--   PLA  (6 walls, 30% gyroid) → base_link, Head, platforms         -->
<!--     Hard, smooth surface. μ₁=0.35, μ₂=0.30                       -->
<!--     kp=1e5, kd=10 (rigid)                                         -->
<!--                                                                    -->
<!--   PETG (6 walls, 30% gyroid) → femur, tibia, servo horn, pushrod  -->
<!--     Slightly tackier than PLA, marginally more flexible            -->
<!--     μ₁=0.40, μ₂=0.35, kp=8e4, kd=12                             -->
<!--                                                                    -->
<!--   TPU  (2 walls, 10% gyroid) → foot pads (ground contact)         -->
<!--     Very soft, high grip cushion pad. Shore A ~95 TPU base         -->
<!--     + thin shell + mostly-air gyroid = compressible pad            -->
<!--     μ₁=0.95, μ₂=0.90, kp=5e3, kd=50 (soft/damped)               -->
<!--                                                                    -->
<!--   Servo housing (factory ABS/nylon) → PTK-7465 bodies             -->
<!--     Smooth injection-moulded plastic. μ₁=0.30, μ₂=0.20           -->
<!--                                                                    -->
<!--   Steel bearings → knee bearings                                   -->
<!--     Low friction, high stiffness. μ₁=0.15, μ₂=0.10               -->
<!-- ================================================================== -->

<!-- ================================================================== -->
<!-- gz_ros2_control Plugin                                             -->
<!-- Bridges ros2_control to Gz Sim joint actuation                     -->
<!-- ================================================================== -->
<gazebo>
  <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
    <parameters>$(find Mini_Dog_URDF_description)/config/controllers.yaml</parameters>
    <ros>
      <remapping>/joint_states:=/true_joint_states</remapping>
    </ros>
  </plugin>
</gazebo>

<!-- ================================================================== -->
<!-- IMU Sensor on imu_link                                             -->
<!-- MPU6050-style noise characteristics:                                -->
<!--   Gyroscope noise density: 0.005 rad/s/√Hz                        -->
<!--   Gyroscope random walk:   0.0002 rad/s²/√Hz                      -->
<!--   Accelerometer noise:     0.01 m/s²/√Hz                          -->
<!--   Accelerometer random walk: 0.0002 m/s³/√Hz                      -->
<!--   Update rate: 333 Hz (matching servo PWM)                         -->
<!-- ================================================================== -->
<gazebo reference="imu_link">
  <sensor name="imu_sensor" type="imu">
    <always_on>true</always_on>
    <update_rate>333</update_rate>
    <topic>imu/data_raw</topic>
    <gz_frame_id>imu_link</gz_frame_id>
    <imu>
      <angular_velocity>
        <x><noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.005</stddev>
          <bias_mean>0.0001</bias_mean>
          <bias_stddev>0.0002</bias_stddev>
        </noise></x>
        <y><noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.005</stddev>
          <bias_mean>0.0001</bias_mean>
          <bias_stddev>0.0002</bias_stddev>
        </noise></y>
        <z><noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.005</stddev>
          <bias_mean>0.0001</bias_mean>
          <bias_stddev>0.0002</bias_stddev>
        </noise></z>
      </angular_velocity>
      <linear_acceleration>
        <x><noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
          <bias_mean>0.001</bias_mean>
          <bias_stddev>0.0002</bias_stddev>
        </noise></x>
        <y><noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
          <bias_mean>0.001</bias_mean>
          <bias_stddev>0.0002</bias_stddev>
        </noise></y>
        <z><noise type="gaussian">
          <mean>0.0</mean>
          <stddev>0.01</stddev>
          <bias_mean>0.001</bias_mean>
          <bias_stddev>0.0002</bias_stddev>
        </noise></z>
      </linear_acceleration>
    </imu>
  </sensor>
</gazebo>

<!-- ================================================================== -->
<!-- BASE LINK - Main chassis                                           -->
<!-- Material: PLA (6 walls, 30% gyroid infill, Anycubic Kobra S1)     -->
<!-- Hard, smooth surface on medium smooth tile                         -->
<!-- ================================================================== -->
<gazebo reference="base_link">
  <mu1>0.35</mu1>
  <mu2>0.30</mu2>
  <kp>1e5</kp>
  <kd>10.0</kd>
  <minDepth>0.001</minDepth>
  <self_collide>false</self_collide>
  <gravity>true</gravity>
  <visual>
    <material>
      <ambient>0.7 0.7 0.7 1.0</ambient>
      <diffuse>0.75 0.75 0.75 1.0</diffuse>
      <specular>0.9 0.9 0.9 1.0</specular>
      <pbr>
        <metal>
          <albedo_map/>
          <metalness>0.1</metalness>
          <roughness>0.55</roughness>
        </metal>
      </pbr>
    </material>
  </visual>
</gazebo>

