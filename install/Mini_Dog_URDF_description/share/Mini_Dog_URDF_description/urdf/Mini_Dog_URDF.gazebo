<!-- ================================================================== -->
<!-- FOOT LINKS - Primary ground contact points                         -->
<!-- Material: TPU (2 walls, 10% gyroid infill, Anycubic Kobra S1)     -->
<!--                                                                    -->
<!-- These foot pads are the ONLY parts that regularly contact ground.   -->
<!-- The TPU base material (Shore A ~95) combined with:                  -->
<!--   - Only 2 wall loops (very thin shell)                            -->
<!--   - 10% gyroid infill (mostly air inside)                          -->
<!-- creates a HIGHLY COMPRESSIBLE cushion pad with:                     -->
<!--   - Excellent grip on tile (high μ)                                -->
<!--   - Significant deformation under load (low kp)                    -->
<!--   - High energy absorption on impact (high kd)                     -->
<!--                                                                    -->
<!-- Contact model tuned for soft-body-on-hard-floor behavior:          -->
<!--   kp=5000 N/m  — 20× softer than PLA, simulates gyroid crush      -->
<!--   kd=50 N·s/m — high damping absorbs landing impact               -->
<!--   maxVel=0.01  — limits penetration velocity for stability         -->
<!--   slip=0.0005  — minimal slip (TPU is very grippy)                 -->
<!-- ================================================================== -->
<gazebo reference="Foot_1">
  <mu1>0.95</mu1>
  <mu2>0.90</mu2>
